<layer number="96" name="Values" color="7" fill="1" visible="yes" active="yes"/>
</layers>
<library>
<description>&lt;b&gt;Ai-Thinker LoRa Ra-02 Breakout Module (DIP-16)&lt;/b&gt;&lt;br&gt;
Footprint matching the Ra-02 dual-row adapter board.&lt;br&gt;
Pin spacing: 2.54mm pitch (100 mil), Row pitch: 22.86mm (900 mil).</description>
<packages>
<package name="LORA_RA02_DIP16">
<description>&lt;b&gt;LoRa Ra-02 Breakout Board (DIP-16)&lt;/b&gt;&lt;br&gt;
Board dimensions: 25.4mm x 25.4mm&lt;br&gt;
Pin Pitch: 2.54mm, Row Pitch: 22.86mm</description>

<!-- Outline PCB -->
<wire x1="-12.7" y1="12.7" x2="12.7" y2="12.7" width="0.127" layer="21"/>
<wire x1="12.7" y1="12.7" x2="12.7" y2="-12.7" width="0.127" layer="21"/>
<wire x1="12.7" y1="-12.7" x2="-12.7" y2="-12.7" width="0.127" layer="21"/>
<wire x1="-12.7" y1="-12.7" x2="-12.7" y2="12.7" width="0.127" layer="21"/>

<!-- Top Row Pads (Left to Right: GND, NSS, MOSI, MISO, SCK, DIO5, DIO4, GND) -->
<pad name="1" x="-8.89" y="11.43" drill="1.0" shape="square"/>
<pad name="2" x="-6.35" y="11.43" drill="1.0"/>
<pad name="3" x="-3.81" y="11.43" drill="1.0"/>
<pad name="4" x="-1.27" y="11.43" drill="1.0"/>
<pad name="5" x="1.27" y="11.43" drill="1.0"/>
<pad name="6" x="3.81" y="11.43" drill="1.0"/>
<pad name="7" x="6.35" y="11.43" drill="1.0"/>
<pad name="8" x="8.89" y="11.43" drill="1.0"/>

<!-- Bottom Row Pads (Left to Right: GND, GND, 3.3V, RST, DIO0, DIO1, DIO2, DIO3) -->
<pad name="9" x="-8.89" y="-11.43" drill="1.0"/>
<pad name="10" x="-6.35" y="-11.43" drill="1.0"/>
<pad name="11" x="-3.81" y="-11.43" drill="1.0"/>
<pad name="12" x="-1.27" y="-11.43" drill="1.0"/>
<pad name="13" x="1.27" y="-11.43" drill="1.0"/>
<pad name="14" x="3.81" y="-11.43" drill="1.0"/>
<pad name="15" x="6.35" y="-11.43" drill="1.0"/>
<pad name="16" x="8.89" y="-11.43" drill="1.0"/>

<text x="-12" y="13.5" size="1.27" layer="25">&gt;NAME</text>
<text x="-12" y="-15" size="1.27" layer="27">&gt;VALUE</text>
</package>
</packages>
<symbols>
<symbol name="RA-02_BREAKOUT">
<wire x1="-12.7" y1="12.7" x2="12.7" y2="12.7" width="0.254" layer="94"/>
<wire x1="12.7" y1="12.7" x2="12.7" y2="-12.7" width="0.254" layer="94"/>
<wire x1="12.7" y1="-12.7" x2="-12.7" y2="-12.7" width="0.254" layer="94"/>
<wire x1="-12.7" y1="-12.7" x2="-12.7" y2="12.7" width="0.254" layer="94"/>

<!-- Pins Top Row -->
<pin name="GND@1" x="-8.89" y="17.78" length="middle" direction="pwr" rot="R270"/>
<pin name="NSS" x="-6.35" y="17.78" length="middle" rot="R270"/>
<pin name="MOSI" x="-3.81" y="17.78" length="middle" rot="R270"/>
<pin name="MISO" x="-1.27" y="17.78" length="middle" rot="R270"/>
<pin name="SCK" x="1.27" y="17.78" length="middle" rot="R270"/>
<pin name="DIO5" x="3.81" y="17.78" length="middle" rot="R270"/>
<pin name="DIO4" x="6.35" y="17.78" length="middle" rot="R270"/>
<pin name="GND@8" x="8.89" y="17.78" length="middle" direction="pwr" rot="R270"/>

<!-- Pins Bottom Row -->
<pin name="GND@9" x="-8.89" y="-17.78" length="middle" direction="pwr" rot="R90"/>
<pin name="GND@10" x="-6.35" y="-17.78" length="middle" direction="pwr" rot="R90"/>
