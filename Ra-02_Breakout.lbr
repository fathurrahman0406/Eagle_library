<connect gate="G$1" pin="GND@9" pad="9"/>
<connect gate="G$1" pin="GND@10" pad="10"/>
<connect gate="G$1" pin="3.3V" pad="11"/>
<connect gate="G$1" pin="RST" pad="12"/>
<connect gate="G$1" pin="DIO0" pad="13"/>
