<pin name="DIO1" x="3.81" y="-17.78" length="middle" rot="R90"/>
<pin name="DIO2" x="6.35" y="-17.78" length="middle" rot="R90"/>
<pin name="DIO3" x="8.89" y="-17.78" length="middle" rot="R90"/>

<text x="-12.7" y="19.05" size="1.778" layer="95">&gt;NAME</text>
<text x="-12.7" y="-21.59" size="1.778" layer="96">&gt;VALUE</text>
</symbol>
</symbols>
